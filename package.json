{
  "name": "pyplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test && npm run test:matrix",
    "vendor": "node scripts/vendor-pyodide.mjs && node scripts/vendor-ruff.mjs",
    "audit:perf": "playwright test --project=chromium --grep \"VC-053|VC-323|VC-326|VC-513|VC-623|VC-814|VC-912\"",
    "audit:contrast": "playwright test --project=chromium --grep \"VC-051|VC-071|VC-514|VC-622|VC-815\"",
    "test:matrix": "MATRIX=1 playwright test --workers=1 --project=chrome-141 --project=chrome-140 --project=edge-141 --project=edge-140 --project=firefox-145 --project=firefox-144 --project=safari-26.1 --project=safari-26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "^0.14.14",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "pyodide": "0.28.3"
  }
}
